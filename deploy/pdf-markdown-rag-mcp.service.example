[Unit]
Description=PDF Markdown RAG MCP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lhj
Group=lhj
WorkingDirectory=/home/lhj/project/evidence_generation
EnvironmentFile=/etc/pdf-markdown-rag/postgres.env
Environment=PYTHONUNBUFFERED=1
Environment=RAG_BACKEND=postgres
Environment=RAG_DATA_DIR=/home/lhj/project/evidence_generation/data/evidence
Environment=MCP_TRANSPORT=streamable-http
Environment=MCP_HOST=127.0.0.1
Environment=MCP_PORT=8000
Environment=MCP_STREAMABLE_HTTP_PATH=/mcp
Environment=MCP_CALL_LOG_ENABLED=1
Environment=MCP_CALL_LOG_PATH=/home/lhj/project/evidence_generation/data/evidence/logs/mcp_calls.jsonl
Environment=MCP_CALL_LOG_RESULT_MODE=full
Environment=MCP_CALL_LOG_MAX_PAYLOAD_STRING_CHARS=2000
Environment=MCP_CALL_LOG_MAX_RESULT_STRING_CHARS=8000
Environment=MCP_CALL_LOG_MAX_RESULT_LIST_ITEMS=50
Environment=DOCUMENT_RERANKER=bge_m3
Environment=CHUNK_RERANKER=bge_m3
Environment=HF_HOME=/data/lhj/huggingface
Environment=HF_HUB_CACHE=/data/lhj/huggingface/hub
Environment=SENTENCE_TRANSFORMERS_HOME=/data/lhj/huggingface
Environment=PG_VECTOR_RETRIEVAL_REQUIRED=1
Environment=PG_VECTOR_MODEL=BAAI/bge-m3
Environment=PG_VECTOR_LOCAL_ONLY=1
Environment=BGE_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
Environment=BGE_RERANKER_LOCAL_ONLY=1
Environment=BGE_RERANKER_BATCH_SIZE=16
Environment=BGE_RERANKER_MAX_LENGTH=1024
ExecStart=/home/lhj/project/evidence_generation/.venv/bin/python -m src.mcp
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
UMask=0027

[Install]
WantedBy=multi-user.target
